NFT_FAMILY=inet
NFT_TABLE=fw4
NFT_SET=granted_macs

# Admin dashboard password. Set this to skip the browser first-run setup.
# It is only read when no password exists yet -- changing it later does
# nothing; use Settings in the dashboard instead.
# ECOWIFI_ADMIN_PASSWORD=change-me-please

# Password hashing cost. Higher is slower to brute-force but slower to log
# in; the count is stored with each password, so changing it does not lock
# out an existing one.
# ECOWIFI_PBKDF2_ITERATIONS=200000

# Force the simulated firewall on (1) or off (0). Defaults to on for any
# non-Linux platform. NEVER set this to 1 on the Orange Pi.
# ECOWIFI_DEV_MODE=0

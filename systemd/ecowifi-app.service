[Unit]
Description=EcoWifi Vendo FastAPI app
After=network.target ecowifi-nftables.service
Requires=ecowifi-nftables.service

[Service]
WorkingDirectory=<APP_DIR>
ExecStart=<APP_DIR>/venv/bin/uvicorn main:app --host 0.0.0.0 --port <PORTAL_PORT>
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# This project is edited on Windows but RUNS on Armbian. A shell script or
# systemd unit checked out with CRLF endings fails on Linux with a
# "bad interpreter" or a silently broken unit file, so pin them to LF.
* text=auto eol=lf

*.sh      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.py      text eol=lf
*.html    text eol=lf
*.md      text eol=lf

*.db  binary
*.png binary
*.jpg binary
*.zip binary
